class LRUCache {
private:
    struct Node {
        int key;
        int value;
        Node* prev;
        Node* next;

        Node(int k, int v){
            key=k;
            value=v;
            prev=NULL;
            next=NULL;
        }
    };

    int capacity;
    unordered_map <int, Node*> mp;
    Node* head;
    Node* tail;

    void init(){
        head=new Node(0,0);
        tail=new Node(0,0);

        head->next=tail;
        tail->prev=head;
    }

    void remove(Node* node){
        node->prev->next=node->next;
        node->next->prev=node->prev;
    }

    void insertFront(Node* node){
        node->next=head->next;
        node->prev=head;

        head->next->prev=node;
        head->next=node;
    }

public:
    LRUCache(int capacity) {
        this->capacity=capacity;
        
        init();
    }
    
    int get(int key) {
        if(!mp.count(key)){
            return -1;
        }

        Node* node=mp[key];
        remove(node);
        insertFront(node);

        return node->value;        
    }
    
    void put(int key, int value) {
        if(mp.count(key)){
            Node* node=mp[key];
            node->value=value;

            remove(node);
            insertFront(node);
            return;
        }

        Node* node=new Node(key, value);
        mp[key]=node;

        insertFront(node);

        if(mp.size()>capacity){
            Node* oldNode=tail->prev;
            mp.erase(oldNode->key);
            remove(oldNode);

            delete oldNode;
        }
        
    }
};

