class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_set<char> seen;
        int ans=0;
        int left=0, right=0;

        for(right; right<s.size(); right++){
            while(seen.count(s[right])){
                seen.erase(s[left]);
                left++;
            }
            
            seen.insert(s[right]);
            ans=max(ans, right-left+1);
        }        

        return ans;
    }
};
