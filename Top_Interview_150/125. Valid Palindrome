class Solution {
private:
    bool isValid(char c){
        if(c>='A' && c<='Z')    return true;
        if(c>='a' && c<='z')    return true;
        if(c>='0' && c<='9')    return true;

        return false;
    }

    char toLower(char c){
        if(c>='A' && c<='Z'){
            return c+('a'-'A');
        }

        return c;
    }

public:
    bool isPalindrome(string s) {
        int left=0, right=s.size()-1;

        while(left<right){
            while(left<right && !isValid(s[left])){
                left++;
            }

            while(left<right && !isValid(s[right])){
                right--;
            }

            if(toLower(s[left])!=toLower(s[right])){
                return false;
            }

            left++;
            right--;
        }
        
        return true;
    }
};
