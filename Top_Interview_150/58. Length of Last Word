class Solution {
public:
    int lengthOfLastWord(string s) {
        int ans=0, temp=0;

        for(int i=0; i<s.size(); i++){
            if(s[i]==' '){
                if(temp!=0){
                    ans=temp;
                }
                temp=0;
            }
            else{
                temp++;

                if(i==s.size()-1){
                    ans=temp;
                }
            }
        }

        return ans;
    }
};


class Solution {
public:
    int lengthOfLastWord(string s) {
        int ans=0;
        int right=s.size()-1;

        while(right>=0 && s[right]==' '){
            right--;
        }

        while(right>=0 && s[right]!=' '){
            ans++;
            right--;
        }

        return ans;
    }
};
