class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int ans=nums.size()+1;
        int left=0, right=0;
        int sum=0;

        for(right; right<nums.size(); right++){
            sum+=nums[right];

            while(sum>=target){
                ans=min(ans, right-left+1);

                sum-=nums[left];
                left++;
            }
        }

        if(ans==nums.size()+1){
            ans=0;
        }

        return ans;
    }
};
